package(default_visibility = ["//visibility:public"])

cc_library(
    name = "nccl_stats",
    srcs = [
        "client.cc",
        "distribution_bucketer.cc",
        "millisecond_bandwidth_output.cc",
        "nccl_stats_aggregator.cc",
        "nccl_stats_container.cc",
        "nccl_stats_reporter.cc",
        "nccl_stats_uploader_executor.cc",
        "nccl_telemetry_provider_stub.cc",
        "nccl_uploader.cc",
        "params.cc",
        "utils.cc",
    ],
    hdrs = [
        "client.h",
        "distribution_bucketer.h",
        "git_tag.h",
        "millisecond_bandwidth_output.h",
        "nccl_log_sink.h",
        "nccl_stats.h",
        "nccl_stats_aggregator.h",
        "nccl_stats_container.h",
        "nccl_stats_reporter.h",
        "nccl_stats_uploader_executor.h",
        "nccl_telemetry_provider_stub.h",
        "nccl_uploader.h",
        "params.h",
        "telemetry_provider.h",
        "uploader_interface.h",
        "utils.h",
    ],
    deps = [
        "//include:nccl_net",
        "//src/proto:acs_configuration_cc_proto",
        "//src/proto:millisecond_bw_file_format_cc_proto",
        "//src/proto:nccl_telemetry_cc_proto",
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/base:log_severity",
        "@abseil-cpp//absl/base:no_destructor",
        "@abseil-cpp//absl/functional:any_invocable",
        "@abseil-cpp//absl/functional:bind_front",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/log:log_sink",
        "@abseil-cpp//absl/log:log_sink_registry",
        "@abseil-cpp//absl/memory:memory",
        "@abseil-cpp//absl/random:random",
        "@abseil-cpp//absl/status:status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:string_view",
        "@abseil-cpp//absl/strings:strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@abseil-cpp//absl/types:span",
        "@acs//cpp:acs_agent_client",
        "@acs//cpp:acs_agent_client_reactor",
        "@acs//cpp:acs_agent_helper",
        "@acs//proto:agent_communication_cc_grpc",
        "@com_google_protobuf//:protobuf",
        "@com_google_protobuf//:protobuf_lite",
        "@com_google_protobuf//src/google/protobuf/util:time_util",
        "@curl",
    ],
)

cc_binary(
    name = "GPUViz",
    additional_linker_inputs = ["plugin_symbols.map"],
    srcs = ["nccl_telemetry.cc"],
    linkopts = ["-Wl,--version-script=$(location plugin_symbols.map)"],
    linkshared = True,
    deps = [
        ":nccl_stats",
    ],
)

cc_library(
    name = "test_utils",
    srcs = ["test_utils.cc"],
    hdrs = ["test_utils.h"],
    deps = [
        ":nccl_stats",
        "//src/proto:nccl_telemetry_cc_proto",
        "@abseil-cpp//absl/random",
        "@abseil-cpp//absl/random:distributions",
    ],
)

